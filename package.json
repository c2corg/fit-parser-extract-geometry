{
  "name": "@c2corg/fit-parser-extract-geometry",
  "version": "2.0.0",
  "description": "Basic FIT parser that only focuses on extracting geometry from activities",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --fix .",
    "lint:ci": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:package": "tsdown --publint --attw",
    "prepare": "husky",
    "prepublishOnly": "npm run build && npm run lint:ci && npm run typecheck && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c2corg/fit-parser-extract-geometry.git"
  },
  "keywords": [
    "fit",
    "garmin",
    "gps",
    "geometry",
    "track"
  ],
  "author": "Camptocamp community <dev@camptocamp.org>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/c2corg/fit-parser-extract-geometry/issues",
    "email": "dev@camptocamp.org"
  },
  "homepage": "https://github.com/c2corg/fit-parser-extract-geometry#readme",
  "dependencies": {
    "debug": "4.4.3"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@eslint/js": "10.0.1",
    "@tsconfig/strictest": "2.0.8",
    "@types/debug": "4.1.13",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/eslint-plugin": "1.6.28",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-security": "4.2.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "tsdown": "0.23.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix --report-unused-disable-directives",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,mjs}": [
      "prettier --write"
    ]
  }
}
